package test;

func main() {
	var x int;
	var y int;

	if x < y {
		x = y;
	} else if x == y {
		y = x;
	} else {
		x = x + 1;
	};

	if z := 1; z < 2 {
		x = z;
	};

	for x < y {
		x = x + 1;
	};

	for i := 0; i < 3; i = i + 1 {
		x = x + i;
	};

	for ; x < y; x = x + 1 {
		y = y + 1;
	};

	for ;; {
		break;
	};
};