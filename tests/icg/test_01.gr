    for 0 != 1 {
        PrintN(1, 1000);
        break;
    };

    for i := 1 ; i < 10 ; i = i + 1 {
        PrintN(3, i, g_c1, g_x);
    };

    return 1;
};

var g_x1 int;
var g_y1, g_z1 int;

func TestIf(lhs, rhs int) int {
    var ret int = 0;
    if lhs > rhs {
         ret = ret + lhs;
    };

    if lhs == rhs {
         ret = ret + 2*lhs;
    } else {
        ret = ret + 3*rhs;
    };

    if lhs < rhs - 2 {
         ret = ret + 10 * lhs;
    } else if lhs > 2 * rhs {
        ret = ret + 3 * rhs;
    } else {
        ret = 2 * ret;
    };
    return ret;
};

func TestFor() {
    var i int = 1;
    for i < 5 {
        Print(i);
        i = i + 1;
    };

    var sum int = 0;
    for i := 1; i < 3; i = i + 2 {
        sum = sum + i;
        PrintN(2, i, sum);
    };

    for {
        Print(0);
        break;
    };

    for i := 0; i < 5; i = i + 1 {
        if i == 1 { continue; };
        for j := 0; j < 6 ; j = j + 1 {
            PrintN(2, i, j);
            if j == 3 { break; };
        };
    };
};

func boo(value bool) bool {
    Print(42);
    return value;
};

func TestLogicalOp() {
    Print(false || false);
    Print(false || true);
    Print(true || false);
    Print(true || true);
    Print(false && false);
    Print(false && true);
    Print(true && false);
    Print(true && true);
    Print(!false);
    Print(!true);
    Print(true || boo(false));
    Print(false && boo(true));
    boo();
};

func FactorialI(n int) int {
	var fact, i int = 1, 1;
	for i <= n {
		fact = fact * i;
		i = i + 1;
	};
	return fact;
};

func FactorialR(n int) int {
	if n <= 1 {
		return 1;
	};
	return n * FactorialR(n-1);
};

func main() {
    var x, y float64 = 3.0, 1.0;
    var k int = 1;
    z := x + y;
    b := x > y;
    PrintN_F(3, x, y, z);
    Print(b);
    var ret int;
    TestLogicalOp();
    TestFor();
    for i := 0; i < 5; i = i + 1 {
        ret = TestIf(3*i + 1, i + 2);
        Print(ret);
    };
    PrintN(2, FactorialI(5), FactorialR(5));
    ret = foo(1, 2, 3);
    Print(ret);
};