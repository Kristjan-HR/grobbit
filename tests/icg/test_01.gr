    };
    Print(x);
    if x := 100; x > 0 {
        Print(x);
    };
    Print(x);

    for k := 0; k < 5; k = k + 1 {
        if k == 1 { continue; };
        for j := 0; j < 6 ; j = j + 1 {
            PrintN(2, k, j);
            if j == 3 { break; };
